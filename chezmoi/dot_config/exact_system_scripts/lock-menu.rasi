/*******************************************************************************
 * 现代化电源菜单主题 - Rofi 2.0 Configuration
 * 支持快捷键操作和现代视觉效果
 ******************************************************************************/

* {
    /* 配色方案 - Catppuccin Mocha 风格 */
    bg-color:            #1e1e2ef2;
    bg-selected:         #89b4fa4d;
    bg-hover:            #89b4fa26;
    fg-color:            #cdd6f4;
    fg-selected:         #ffffff;
    border-color:        #89b4fa80;
    urgent-color:        #f38ba8;
    transparent:         #00000000;

    background-color:    @transparent;
    text-color:          @fg-color;
    font:                "JetBrains Mono Nerd Font 13";
}

window {
    width:               100%;
    height:              100%;
    location:            center;
    anchor:              center;
    background-color:    @bg-color;
    border:              0px;
    border-radius:       0px;
}

mainbox {
    enabled:             true;
    spacing:             0px;
    padding:             0px;
    background-color:    @transparent;
    children:            [ "inputbar", "listview", "message" ];
}

/* 占位符，用于垂直居中 */
dummy {
    expand:              false;
    background-color:    @transparent;
}

inputbar {
    enabled:             true;
    spacing:             0px;
    padding:             5% 16px 3% 16px;
    background-color:    @transparent;
    text-color:          @fg-color;
    children:            [ "prompt" ];
}

prompt {
    enabled:             true;
    padding:             12px 20px;
    background-color:    @transparent;
    text-color:          @fg-color;
    font:                "JetBrains Mono Nerd Font Bold 15";
}

listview {
    enabled:             true;
    columns:             3;
    lines:               2;
    cycle:               true;
    dynamic:             true;
    scrollbar:           false;
    reverse:             false;
    fixed-height:        false;
    fixed-columns:       false;
    flow:                horizontal;
    spacing:             64px;
    padding:             10% 15% 10% 15%;
    background-color:    @transparent;
}

element {
    enabled:             true;
    spacing:             12px;
    padding:             32px 24px;
    border:              2px solid;
    border-radius:       12px;
    border-color:        @transparent;
    background-color:    #31324866;
    text-color:          @fg-color;
    cursor:              pointer;
}

element normal.normal {
    background-color:    #31324866;
    text-color:          @fg-color;
}

element selected.normal {
    background-color:    @bg-selected;
    text-color:          @fg-selected;
    border-color:        @border-color;
}

element alternate.normal {
    background-color:    #31324866;
    text-color:          @fg-color;
}

element-icon {
    size:                40px;
    cursor:              inherit;
    background-color:    @transparent;
    text-color:          inherit;
}

element-text {
    vertical-align:      0.5;
    horizontal-align:    0.5;
    cursor:              inherit;
    background-color:    @transparent;
    text-color:          inherit;
    font:                "JetBrains Mono Nerd Font Bold 13";
}

message {
    enabled:             true;
    padding:             3% 16px 5% 16px;
    background-color:    @transparent;
    text-color:          @fg-color;
}

textbox {
    background-color:    @transparent;
    text-color:          @fg-color;
    vertical-align:      0.5;
    horizontal-align:    0.5;
    font:                "JetBrains Mono Nerd Font 11";
}

error-message {
    padding:             20px;
    background-color:    @bg-color;
    text-color:          @urgent-color;
}
